NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk account mode. Leave these unset for keyless local guest sessions.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Optional Sentry error reporting. Leave the DSNs unset to disable it.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional build-time source map upload credentials.
SENTRY_ORG=your-org
SENTRY_PROJECT=signalforge-frontend
SENTRY_AUTH_TOKEN=
