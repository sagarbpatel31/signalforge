# Anthropic Claude — powers AI brief / posts / tasks / weekly / digest generation
ANTHROPIC_API_KEY=your_anthropic_key_here
# Optional — pin a different Claude model (defaults to claude-opus-4-7)
# ANTHROPIC_MODEL=claude-opus-4-7
# Per-account generation budget for all AI mutation routes (fixed one-hour window)
# AI_RATE_LIMIT_PER_HOUR=20

# Upstash Redis (get from upstash.com — free tier) — KV cache for feeds + profile
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Resend — daily digest email (https://resend.com)
RESEND_API_KEY=your_resend_key_here
# Free Resend accounts can only send from onboarding@resend.dev until a domain is verified
RESEND_FROM=SignalForge <onboarding@resend.dev>
# Recipient of the daily digest email
DIGEST_EMAIL=you@example.com

# Session signing key — REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Profiles, workbench state, and bookmarks are keyed by a session id signed with
# this value. Locally, an unset key is auto-generated into backend/data/.session_secret.
# Rotating it invalidates every existing session (users re-onboard).
SESSION_SECRET=your_random_session_secret_here

# Clerk accounts — required in production account mode. Use the same Clerk
# application as the frontend. CLERK_JWT_KEY enables networkless verification.
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_KEY\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://your-app.vercel.app
# Optional rollout override. Production rejects legacy sessions by default as
# soon as CLERK_SECRET_KEY is configured; migration still accepts a valid old token.
# ALLOW_LEGACY_SESSIONS=false

# Vercel Cron protection — set to any random string and add the same value to Vercel env vars.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>"; /api/ingest rejects requests
# that don't carry it. Required in production — /api/ingest also sends the digest email,
# so an unset value there returns 503 rather than leaving the endpoint open.
CRON_SECRET=your_random_secret_here

# Manual feed refresh budget per account in each 15-minute window.
# FEED_REFRESH_RATE_LIMIT=3
# Production cold reads never scrape providers; cron owns ingestion. Set true
# only when local development should populate an empty cache automatically.
# ENABLE_COLD_FEED_REFRESH=false
# Optional isolated file-fallback root (useful for disposable test environments).
# SIGNALFORGE_DATA_DIR=/tmp/signalforge-data

# CORS — set to your deployed frontend URL. When this is a *.vercel.app domain,
# the API also allows that project's preview deployments automatically.
FRONTEND_URL=https://your-app.vercel.app
# Optional — override the allowed-origin regex (e.g. for a custom domain's previews)
# CORS_ALLOW_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# Optional Sentry error reporting. No events are sent when SENTRY_DSN is unset.
# Request bodies, cookies, headers, and user identity are scrubbed before send.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
